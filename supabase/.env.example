# Supabase Custom SMTP Provider Settings
# Configure with your SMTP credentials (do not commit .env with real credentials)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-specific-password"
SMTP_ADMIN_EMAIL="admin@example.com"
SMTP_SENDER_NAME="WordBridge"
